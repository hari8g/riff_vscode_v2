{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^#]*#[^#@]*@[a-z]+$"
            }
          },
          "ungrounded": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "w": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "bugfix",
                "feature",
                "merge",
                "review",
                "refactor",
                "onboarding",
                "unknown"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "H": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "anchors",
          "w",
          "H"
        ]
      }
    },
    "branch": {
      "type": "string",
      "enum": [
        "single",
        "blended",
        "probe",
        "clarify",
        "generic"
      ]
    },
    "w": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "bugfix",
          "feature",
          "merge",
          "review",
          "refactor",
          "onboarding",
          "unknown"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "H": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "primitives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "bugfix",
              "feature",
              "merge",
              "review",
              "refactor",
              "onboarding",
              "unknown"
            ]
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "intent",
          "weight"
        ]
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^#]*#[^#@]*@[a-z]+$"
      }
    },
    "expansion": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "callers",
              "callees",
              "exercising_test",
              "sibling_template",
              "implemented_interfaces",
              "both_branch_touched",
              "co_change_partners",
              "tests_over",
              "invariants_on",
              "reference_closure",
              "inheritance_tree",
              "dynamic_dispatch_sites",
              "module_summaries",
              "file_skeletons",
              "one_hop"
            ]
          },
          "hops": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "cap": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "exclude": {
            "type": "string",
            "enum": [
              "in_diff",
              "tests",
              "generated"
            ]
          }
        },
        "required": [
          "rule"
        ]
      }
    },
    "historyScope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "blame_on_anchors",
          "reverts_touching_anchors",
          "origin_commits_of_sibling",
          "both_branch_summaries",
          "recent_incidents_on",
          "adrs"
        ]
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fixed": {
          "type": "object",
          "properties": {
            "map": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "runbook": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "map",
            "runbook"
          ]
        },
        "variable": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "total",
        "fixed",
        "variable"
      ]
    },
    "stages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "minItems": 2,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "enum": [
                      "bugfix",
                      "feature",
                      "merge",
                      "review",
                      "refactor",
                      "onboarding",
                      "unknown"
                    ]
                  },
                  "w": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "enum": [
                        "bugfix",
                        "feature",
                        "merge",
                        "review",
                        "refactor",
                        "onboarding",
                        "unknown"
                      ]
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "required": [
                  "label",
                  "intent",
                  "w"
                ]
              }
            }
          },
          "required": [
            "question",
            "options"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "units",
    "branch",
    "w",
    "H",
    "primitives",
    "anchors",
    "expansion",
    "historyScope",
    "budget",
    "stages",
    "question",
    "policyVersion"
  ]
}

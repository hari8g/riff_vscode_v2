{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "route": {
      "type": "object",
      "properties": {
        "w": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "bugfix",
              "feature",
              "merge",
              "review",
              "refactor",
              "onboarding",
              "unknown"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "H": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "branch": {
          "type": "string",
          "enum": [
            "single",
            "blended",
            "probe",
            "clarify",
            "generic"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "w",
        "H",
        "branch",
        "stages"
      ]
    },
    "budget": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tokensUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "openLookups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tool",
          "args",
          "reason"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "signature",
              "body",
              "summary",
              "commit",
              "co_change",
              "convention",
              "skill",
              "runbook",
              "test",
              "diff"
            ]
          },
          "source": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "range": {
                        "type": "object",
                        "properties": {
                          "startLine": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "endLine": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "startLine",
                          "endLine"
                        ]
                      },
                      "blobHash": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{7,40}$"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{7,40}$"
                      }
                    },
                    "required": [
                      "commit"
                    ]
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "virtual": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "virtual"
                ]
              }
            ]
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "why": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "bugfix",
                  "feature",
                  "merge",
                  "review",
                  "refactor",
                  "onboarding",
                  "unknown"
                ]
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "score": {
                "type": "number"
              }
            },
            "required": [
              "intent",
              "rule",
              "weight",
              "score"
            ]
          },
          "tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tier",
          "kind",
          "source",
          "hash",
          "why",
          "tokens",
          "stage",
          "content"
        ]
      }
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "packId",
    "repo",
    "route",
    "budget",
    "tokensUsed",
    "openLookups",
    "items",
    "policyVersion",
    "schemaVersion",
    "createdAt"
  ]
}

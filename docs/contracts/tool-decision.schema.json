{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "allow"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "serve"
        },
        "result": {},
        "from": {
          "type": "string",
          "enum": [
            "cache",
            "index"
          ]
        }
      },
      "required": [
        "kind",
        "result",
        "from"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rewrite"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tool",
        "args",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "reflect"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "block"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    }
  ]
}

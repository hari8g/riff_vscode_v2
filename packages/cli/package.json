{
  "name": "riaf",
  "version": "0.1.0",
  "description": "riaf CLI: index | pack | jump | impact | history | wiki | eval | doctor | serve | init.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

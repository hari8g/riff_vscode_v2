{
  "name": "riaf-vscode-v2",
  "version": "0.1.0",
  "description": "VS Code extension: Copilot LM tools, @riaf participant hand-off, console webview, settings.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/extension"
  },
  "dependencies": {
    "@riaf/kernel": "workspace:*",
    "@riaf/daemon": "workspace:*",
    "@riaf/models": "workspace:*",
    "@riaf/compiler": "workspace:*"
  },
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "publisher": "bosch-mps",
  "displayName": "RIAF v2"
}
